# Copy to .env and fill in. Never commit .env.

# Supabase: Project settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.adtzwdoturygbvjmlizv.supabase.co:5432/postgres

PORT=3000
WEB_ORIGIN=http://localhost:4200
VITE_API_URL=http://localhost:3000/api

# Auth: any long random string. Stateless JWT - nothing else to configure,
# nothing stored server-side (see apps/api/src/app/utils/jwt.ts).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Admin account seed (npm run db:seed-admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Clinic Admin

# SMTP for cancellation emails (M6). Unset in dev -> emails print to the console.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
